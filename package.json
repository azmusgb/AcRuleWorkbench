{
  "name": "fw-editor-viewer-tests",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:viewer": "node scripts/build-viewer-assets.js",
    "check:viewer-sync": "node scripts/check-viewer-asset-sync.js",
    "test:viewer": "node tests/static/fw-editor-viewer.static.test.js && node tests/static/fw-editor-viewer-scripts.static.test.js && node tests/static/style-surfaces.static.test.js",
    "test:browser": "node node_modules/@playwright/test/cli.js test tests/browser/fw-editor-viewer-blank-screen.spec.js tests/browser/fw-editor-viewer.behavior.spec.js tests/browser/fw-editor-viewer-resource-workspaces.spec.js",
    "lint:viewer": "node scripts/lint-viewer.js",
    "test": "npm run test:viewer",
    "test:ci": "npm run test:viewer && npm run lint:viewer"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "eslint": "^9.0.0"
  },
  "viewerBuild": "v104-fw-editor-viewer"
}
